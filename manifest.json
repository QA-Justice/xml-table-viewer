{
  "name": "XML Table Viewer",
  "version": "1.1.0",
  "manifest_version": 3,
  "description": "Convert XML and SOAP responses to a table. Copy as Markdown, export CSV, pivot, and filter.",
  "permissions": ["sidePanel"],
  "optional_permissions": ["clipboardRead"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open XML Table Viewer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
